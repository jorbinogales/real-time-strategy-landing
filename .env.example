# Copia a .env.local y ajusta. Ninguna de estas claves debe subirse al repositorio.

# Vacía = PGlite local en ./.data/pg. Con valor = Postgres (p. ej. Railway).
DATABASE_URL=

# URL del juego a la que se entra tras dar el correo.
GAME_URL=http://localhost:8000/menu.html
# URL pública de este sitio (para los enlaces de baja del CSV).
SITE_URL=http://localhost:3000

# Secretos (32+ bytes aleatorios: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# En producción son obligatorios; en desarrollo hay valores por defecto inseguros.
IP_HASH_SECRET=
UNSUBSCRIBE_SECRET=
SESSION_SECRET=

# Panel /admin. Sin valor, el panel queda deshabilitado.
ADMIN_PASSWORD=
